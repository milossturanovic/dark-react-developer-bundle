# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================
#
# Copy this file to .env.local and fill in the values.
#
# ADMIN_PASSWORD — the password used to log in at /admin/login
# REQUIRED. The admin login API refuses to authenticate if this is not set.
# Use a long, randomly generated string in production (20+ characters).
#
# ============================================================================

ADMIN_PASSWORD=replace-me-with-a-strong-password
