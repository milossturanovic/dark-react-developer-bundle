# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# admin data — do NOT commit real project content
# The seed file (data/projects.json) ships with the template, but any edits
# the developer makes via /admin should stay out of the repo.
# Copy data/projects.json to data/projects.example.json if you want to track defaults.
/data/*.json
!/data/projects.example.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
